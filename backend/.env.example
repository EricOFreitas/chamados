# Ambiente
NODE_ENV=development
PORT=3001
# Fuso do servidor — define o que é "o dia" nos filtros de data e relatórios.
# Sem isso o container roda em UTC e o último dia do filtro fica cortado.
TZ=America/Sao_Paulo

# Banco de dados (PostgreSQL no Coolify)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chamados?schema=public"

# JWT
JWT_SECRET=troque_por_segredo_forte_aqui
JWT_REFRESH_SECRET=troque_por_refresh_segredo_forte_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@exemplo.com
SMTP_PASS=suasenha
SMTP_FROM="Chamados Suporte <seuemail@exemplo.com>"
# Só para servidor de e-mail próprio com certificado que não bate com o hostname.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# E-mail que recebe notificações de novos chamados.
# SMTP_FROM é obrigatório: sem remetente o servidor SMTP recusa a mensagem.
TECHNICIAN_EMAIL=seuemail@exemplo.com

# URL do frontend (para links nos emails)
FRONTEND_URL=https://chamados.exemplo.com
